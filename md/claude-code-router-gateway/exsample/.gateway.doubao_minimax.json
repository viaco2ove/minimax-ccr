{
  "server": {
    "host": "127.0.0.1",
    "port": 3428,
    "timeout_ms": 600000,
    "log_level": "debug",
    "log_file": "logs/ccrg.log",
    "proxy_url": "",
    "api_key": "xxx",
    "claude_path": ""
  },
  "providers": {
    "minimax": {
      "api_base_url": "https://api.minimaxi.com/anthropic",
      "api_key": "xxx",
      "protocol": "codeplan_anthropic",
      "models": ["MiniMax-M2.7"],
      "capabilities": {
        "tool_use": true,
        "streaming": true,
        "thinking": true,
        "vision": true,
        "max_context": 128000
      },
      "cost_tier": "cheap",
      "timeout_ms": 1200000,
      "default_params": {
        "max_tokens": 4096
      },
      "retry": {
        "max_attempts": 3,
        "retry_on_status": [429, 500, 502, 503]
      }
    },
    "qianfan": {
      "api_base_url": "https://qianfan.baidubce.com/anthropic/coding",
      "api_key": "xxx",
      "protocol": "codeplan_anthropic",
      "models": ["qianfan-code-latest","ernie-4.5-turbo-20260402"],
      "capabilities": {
        "tool_use": true,
        "streaming": true,
        "thinking": true,
        "vision": true,
        "max_context": 128000
      },
      "per_request_delay_ms": 1500,
      "cost_tier": "cheap",
      "timeout_ms": 120000,
      "retry": {
        "max_attempts": 1,
        "retry_on_status": [429, 500, 502, 503]
      }
    },
   "doubao": {
      "api_base_url": "https://ark.cn-beijing.volces.com/api/coding",
      "api_key": "xxx",
      "protocol": "codeplan_anthropic",
      "models": ["ark-code-latest","glm-5.2","Kimi-K2.6","doubao-seed-2.0-code"],
      "capabilities": {
        "tool_use": true,
        "streaming": true,
        "thinking": true,
        "vision": true,
        "max_context": 128000
      },
      "per_request_delay_ms": 500,
      "cost_tier": "cheap",
      "timeout_ms": 120000,
      "retry": {
        "max_attempts": 1,
        "retry_on_status": [429, 500, 502, 503]
      }
    },
    "mmx": {
      "api_base_url": "https://127.0.0.1:3457",
      "api_key": "xxx",
      "protocol": "mmx",
      "models": ["MiniMax-M2.7"],
      "capabilities": {
        "tool_use": true,
        "streaming": true,
        "thinking": true,
        "vision": true,
        "max_context": 128000
      },
      "cost_tier": "cheap",
      "default_params": {
        "max_tokens": 4096
      },
      "retry": {
        "max_attempts": 2,
        "retry_on_status": [429, 500, 502, 503]
      }
    },
    "deepseek": {
      "api_base_url": "https://api.deepseek.com",
      "api_key": "xxx",
      "protocol": "chat_openai",
      "models": ["deepseek-chat", "deepseek-reasoner", "deepseek-v4-pro","deepseek-v4-flash"],
      "capabilities": {
        "tool_use": true,
        "streaming": true,
        "thinking": true,
        "vision": true,
        "max_context": 64000
      },
      "cost_tier": "premium",
      "retry": {
        "max_attempts": 2,
        "retry_on_status": [429, 500, 502, 503]
      }
    }
  },
  "routing": {
    "default": "minimax:MiniMax-M2.7",
    "scenarios": {
      "background": {
        "route": "minimax:MiniMax-M2.7",
        "fallback": ["doubao:ark-code-latest"]
      },
      "think": {
        "route": "doubao:ark-code-latest",
        "fallback": ["doubao:ark-code-latest","minimax:MiniMax-M2.7"]
      },
      "long_context": {
        "route": "doubao:ark-code-latest",
        "fallback": ["doubao:ark-code-latest","minimax:MiniMax-M2.7"],
        "threshold": 100000
      },
      "web_search": {
        "route": "minimax:MiniMax-M2.7",
        "fallback": ["doubao:ark-code-latest","minimax:MiniMax-M2.7"]
      },
      "image": {
        "route": "mmx:MiniMax-M2.7",
        "fallback": ["minimax:MiniMax-M2.7","doubao:ark-code-latest"]
      },
      "compact": {
        "route": "minimax:MiniMax-M2.7",
        "fallback": ["doubao:ark-code-latest"]
      }
    },
    "tool_routing": {
      "cheap_tasks": {
        "match": [
          "Read", "Glob", "Grep",
          "Bash(git status)", "Bash(git diff)", "Bash(git log)",
          "Bash(ls *)", "Bash(cat *)", "Bash(head *)"
        ],
        "match_mode": "any",
        "route": "minimax:MiniMax-M2.7",
        "fallback": ["doubao:ark-code-latest","minimax:MiniMax-M2.7"]
      },
      "standard_tasks": {
        "match": ["Edit", "Write", "NotebookEdit"],
        "match_mode": "any",
        "route": "minimax:MiniMax-M2.7",
        "fallback": ["doubao:ark-code-latest","minimax:MiniMax-M2.7"]
      },
      "complex_tasks": {
        "match": ["Agent", "TaskCreate", "EnterPlanMode"],
        "match_mode": "any",
        "route": "doubao:ark-code-latest",
        "fallback": ["doubao:ark-code-latest","minimax:MiniMax-M2.7"]
      }
    },
    "keyword_routing": {
      "rules": [
        {
          "keywords": ["架构", "architecture", "重构", "refactor", "优化", "设计模式", "模块化",
            "拆分", "合并", "升级", "改造","分析","设计","处理"],
          "match_mode": "any",
          "scope": "user_message",
          "route": "doubao:ark-code-latest",
          "fallback": ["minimax:MiniMax-M2.7"]
        },
        {
          "keywords": ["/compact", "compact"],
          "match_mode": "any",
          "scope": "user_message",
          "route": "minimax:MiniMax-M2.7",
          "fallback": ["doubao:ark-code-latest"]
        }
      ]
    },
    "priority": ["scenario", "tool_routing", "keyword_routing", "default"]
  },
  "quota": {
    "minimax_codeplan": {
      "enabled": true,
      "provider": "minimax",
      "track_usage": true,
      "fallback_on_exhaust": "minimax:MiniMax-M2.7",
      "warning_threshold": 0.2
    }
  },
  "workflow": {
    "enabled": true,
    "intention_analyze": ["minimax:MiniMax-M2.7"],
    "chat_intention": ["minimax:MiniMax-M2.7"],
    "analyze_plan": ["doubao:ark-code-latest"],
    "execute_solve": ["minimax:MiniMax-M2.7"]
  }
}